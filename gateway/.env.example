# Copia este archivo como gateway/.env y rellena SG_API_KEY.
# gateway/.env NO se sube a git (está en .gitignore).

# Backend. En la Pi 5 el backend corre en la misma máquina.
SG_API_URL=http://localhost:8000/api/v1
SG_DEVICE_ID=pi-vivero-01
# La API key que imprimió `python -m app.seed` (se muestra una sola vez).
SG_API_KEY=

# Arduino. "auto" busca en /dev/serial/by-id/ (o el COM del Arduino en Windows).
SG_SERIAL_PORT=auto
SG_BAUD=9600

# Envío: hasta 100 lecturas cada 10 s.
SG_BATCH_SIZE=100
SG_SEND_INTERVAL=10

# Reloj: auto = timedatectl en la Pi; en una laptop sin timedatectl se confía
# en el reloj del sistema. Opciones: auto | timedatectl | system
SG_CLOCK=auto
